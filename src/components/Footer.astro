---
import Emblem from "../components/Emblem.astro";
import { site } from "../data/site";

const nav = [
  { label: "O nás", href: "/#o-nas" },
  { label: "Ponuka", href: "/#brany-branky" },
  { label: "Fotogaléria", href: "/#ploty-zabradlia" },
  { label: "Kontakt", href: "/#kontakt" },
];
const services = [
  "Kované brány",
  "Kované ploty a zábradlia",
  "Výroba z kovu a antikoru",
  "Montáž pohonov brán NICE, KEY",
  "Bezplatné zameranie a cenová ponuka",
];
---

<footer class="relative bg-bg bg-spotlight text-ink">
  <div class="mx-auto max-w-container px-6 pt-20 pb-10 md:pt-24">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <a href="/" class="inline-flex items-center gap-4" aria-label="KOVOCER.eu – domov" data-top>
          <Emblem class="h-14 w-14 shrink-0 text-accent" />
          <span class="block">
            <span class="block font-display text-2xl leading-none font-bold tracking-[0.18em] text-ink">KOVOCER<span class="font-normal tracking-[0.06em] text-accent">.eu</span></span>
            <span class="mt-2 block font-display text-[0.65rem] leading-none tracking-[0.2em] whitespace-nowrap text-accent uppercase">Kovovýroba · Prečín</span>
          </span>
        </a>
        <p class="mt-6 text-sm leading-relaxed text-muted">Kovovýroba v Prečíne: kované brány, ploty, zábradlia a schodiská z kovu a antikoru na mieru.</p>
      </div>

      <div>
        <h2 class="font-display text-sm font-bold tracking-[0.2em] text-ink uppercase">Navigácia</h2>
        <ul class="mt-6 space-y-0 text-sm text-muted md:space-y-3">
          {nav.map((item) => <li><a href={item.href} class="flex min-h-10 items-center transition-colors hover:text-accent md:inline md:min-h-0">{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-bold tracking-[0.2em] text-ink uppercase">Služby</h2>
        <ul class="mt-6 space-y-3 text-sm text-muted">
          {services.map((service) => <li>{service}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-bold tracking-[0.2em] text-ink uppercase">Kontakt</h2>
        <ul class="mt-6 space-y-1 text-sm text-muted md:space-y-4">
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>{site.street},<br />{site.city}</span>
          </li>
          <li class="flex items-center gap-3 md:items-start">
            <svg class="h-4 w-4 shrink-0 text-accent md:mt-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"></path></svg>
            <a href={site.phoneHref} class="flex min-h-10 items-center transition-colors hover:text-accent md:inline md:min-h-0">{site.phone}</a>
          </li>
          <li class="flex items-center gap-3 md:items-start">
            <svg class="h-4 w-4 shrink-0 text-accent md:mt-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
            <a href={`mailto:${site.email}`} class="flex min-h-10 items-center transition-colors hover:text-accent md:inline md:min-h-0">{site.email}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-white/10 pt-8 md:flex-row md:items-center md:justify-between">
      <p class="text-xs leading-relaxed text-muted">
        {site.name} · {site.owner} · {site.street}, {site.city}
        <span class="hidden md:inline"> · </span>
        <a href={site.phoneHref} class="flex min-h-10 items-center transition-colors hover:text-accent md:inline md:min-h-0">{site.phone}</a>
        <span class="hidden md:inline"> · </span>
        <a href={`mailto:${site.email}`} class="flex min-h-10 items-center transition-colors hover:text-accent md:inline md:min-h-0">{site.email}</a>
        <span class="hidden md:inline"> — </span>
        © {new Date().getFullYear()} {site.name}. Všetky práva vyhradené.
      </p>
    </div>
  </div>
</footer>
