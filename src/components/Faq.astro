---
import { faqs } from "../data/faqs";
---

<section id="faq" class="scroll-mt-[calc(4.5rem-15px)] bg-[#F0F0F0] py-20 text-bg md:scroll-mt-[calc(5.5rem-15px)] md:py-28">
  <div class="mx-auto max-w-3xl px-6">
    <header class="text-center" data-reveal>
      <p class="font-display text-xs tracking-[0.32em] text-[#8C7A47] uppercase">Časté otázky</p>
      <h2 class="mt-6 font-display text-4xl leading-[1.12] font-bold tracking-tight text-bg uppercase md:text-6xl">Čo sa nás najčastejšie pýtate</h2>
    </header>
    <div class="mt-12 space-y-3" data-reveal>
      {faqs.map((item) => (
        <details class="group rounded-xl bg-white p-6 shadow-[0_20px_50px_-25px_rgba(11,23,28,0.35)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-xl font-bold text-bg">
            <h3 class="text-xl">{item.q}</h3>
            <span aria-hidden="true" class="text-2xl text-[#8C7A47] transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-4 leading-relaxed text-[#3D4A50]">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
