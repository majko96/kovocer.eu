---
import { site, button } from "../data/site";

const rows = [
  { icon: "M12 21s-7-6.5-7-12a7 7 0 1 1 14 0c0 5.5-7 12-7 12z", extra: "circle", text: [site.street, site.city] },
  { icon: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z", href: site.phoneHref, text: [site.phone] },
  { icon: "m3 7 9 6 9-6", extra: "rect", href: `mailto:${site.email}`, text: [site.email] },
];
---

<section id="kontakt" class="scroll-mt-[calc(4.5rem-15px)] bg-[#F0F0F0] py-20 text-bg md:scroll-mt-[calc(5.5rem-15px)] md:py-28">
  <div class="mx-auto max-w-container px-6">
    <div class="relative grid gap-0 overflow-hidden rounded-2xl shadow-[0_40px_90px_-35px_rgba(11,23,28,0.55)] md:grid-cols-[1.2fr_1fr]" data-reveal>
      <div class="bg-white p-8 md:p-12">
        <p class="font-display text-xs tracking-[0.32em] text-[#8C7A47] uppercase">Kontakt · Prečín</p>
        <h2 class="mt-6 font-display text-4xl leading-[1.12] font-bold tracking-tight text-bg uppercase md:text-6xl">Zavolajte, zameriame vám bránu</h2>
        <p class="mt-6 text-lg leading-relaxed text-[#3D4A50]">
          Ku každej zákazke pristupujeme individuálne. Pomôžeme s návrhom aj realizáciou, bezplatne zameriame a vypracujeme cenovú ponuku.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={site.phoneHref} class:list={[button, "px-6 py-3.5 text-sm shadow-[0_0_40px_-6px_rgba(201,181,126,0.65)] hover:shadow-[0_0_60px_-4px_rgba(201,181,126,0.85)]"]}>{site.phone}</a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-3 rounded-md px-6 py-3.5 font-display text-sm font-bold tracking-[0.14em] text-bg uppercase ring-1 ring-[#8C7A47] transition hover:bg-accent/10"
            >Napísať e-mail</a
          >
        </div>
      </div>
      <div class="relative bg-bg p-8 text-ink md:p-12">
        <div class="absolute inset-x-0 top-0 h-48 bg-[image:radial-gradient(ellipse_at_top,rgba(201,181,126,0.2),transparent_70%)]"></div>
        <div class="relative">
          <p class="font-display text-xs tracking-[0.32em] text-accent">KOVOCER.eu</p>
          <h3 class="mt-3 font-display text-3xl font-bold text-ink uppercase">{site.owner}</h3>
          <ul class="mt-8 space-y-4">
            {rows.map((row) => (
              <li class="flex items-center gap-4">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-accent/15 text-accent ring-1 ring-accent/50">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
                    <path d={row.icon}></path>
                    {row.extra === "circle" && <circle cx="12" cy="9" r="2.5"></circle>}
                    {row.extra === "rect" && <rect x="3" y="5" width="18" height="14" rx="2"></rect>}
                  </svg>
                </span>
                <span class="text-lg">
                  {row.href ? <a href={row.href} class="-my-3 inline-block py-3">{row.text[0]}</a> : row.text.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
